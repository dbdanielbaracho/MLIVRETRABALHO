{
  "name": "@mlivretrabalho/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && pnpm exec tsc -p tsconfig.test.json && node --test .test-dist/*.test.js",
    "migrate": "node dist/migrate.js",
    "privacy:retention": "node dist/privacy-retention.js",
    "privacy:requests:ops": "node dist/privacy-requests-ops.js",
    "privacy:legal-holds:ops": "node dist/privacy-legal-holds-ops.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "fastify": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "@types/pg": "^8.15.5"
  }
}
