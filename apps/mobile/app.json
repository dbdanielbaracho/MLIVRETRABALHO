{
  "expo": {
    "name": "MLivreTrabalho",
    "slug": "mlivretrabalho",
    "scheme": "mlivretrabalho",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o MLivreTrabalho use sua localização durante o check-in e check-out."
        }
      ]
    ],
    "experiments": {"typedRoutes": true}
  }
}
